# Copy this file to ~/.config/recon.env (or export the variables in your shell)
# and fill in your own API keys. Never commit the real file.
#
#   cp recon.env.example ~/.config/recon.env
#   $EDITOR ~/.config/recon.env

# VirusTotal — one key, or several comma-separated to rotate the public rate limit.
export VT_API_KEY=""
# export VT_API_KEYS="key1,key2,key3"

# urlscan.io
export URLSCAN_API_KEY=""

# Out-of-band interaction (interactsh-client base domain), used by ssrf-header-fuzz.sh
# export OAST_DOMAIN="youruniqueid.oast.fun"
